<?xml version="1.0"?>
<package format="3">
  <name>eated_navigation</name>
  <version>0.1.0</version>
  <description>Mapping and isolated Nav2 environment for the calibrated EATED robot.</description>
  <maintainer email="imsunghy@gmail.com">fcsl</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
